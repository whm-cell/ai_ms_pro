{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.ai-ms-pro/standards/agent-trace.schema.json",
  "title": "Repo Local Agent Trace Span",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "span_id",
    "parent_span_id",
    "name",
    "kind",
    "start_time",
    "end_time",
    "status",
    "agent",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-trace/v1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "span_id": {
      "type": "string",
      "minLength": 4,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "parent_span_id": {
      "type": ["string", "null"],
      "minLength": 4,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": [
        "agent_run",
        "agent_step",
        "tool_call",
        "check",
        "guardrail",
        "handoff",
        "reducer",
        "event"
      ]
    },
    "event": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["ok", "error", "unset"]
        },
        "message": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null", "array"],
        "items": {
          "type": ["string", "number", "integer", "boolean", "null"]
        }
      }
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "workstream_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^WS-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["span", "file", "pr", "evidence", "handoff"]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "maxLength": 400
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "rule"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["redacted", "unredacted", "not_applicable"]
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
