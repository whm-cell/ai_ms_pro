{
  "schema_version": 1,
  "contracts": [
    {
      "name": "check_ai_governance",
      "purpose": "Validate canonical AI governance documents, traceability metadata, runtime leak boundaries, and governance follow-up warnings.",
      "path": "scripts/check_ai_governance.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_ai_governance.py",
      "inputs": ["docs/ai", "docs/requirements", ".codex/harness.toml", "git diff state"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["read_repo", "git_read"],
      "permissions": ["read-repo", "git-read"],
      "timeout_seconds": 60,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "hook",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_ai_governance.py"]
    },
    {
      "name": "check_code_shape",
      "purpose": "Check repo Python and shell files against code-shape budgets for staged or repo-wide review.",
      "path": "scripts/check_code_shape.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_code_shape.py --all",
      "inputs": [".codex/code_shape.toml", "repository source files", "git index"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["read_repo", "git_read"],
      "permissions": ["read-repo", "git-read"],
      "timeout_seconds": 60,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [
        ".codex/hooks/run_with_repo_python.sh scripts/check_code_shape.py --all",
        ".codex/hooks/run_with_repo_python.sh scripts/check_code_shape.py --staged"
      ]
    },
    {
      "name": "ruff_python_linter",
      "purpose": "Run the repo P0 Python linter over harness hooks, scripts, and tests.",
      "path": "pyproject.toml",
      "command": "python3 -m ruff check .codex/hooks scripts tests",
      "inputs": ["pyproject.toml", ".codex/requirements.txt", ".codex/hooks", "scripts", "tests"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 60,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": ["python3 -m ruff check .codex/hooks scripts tests"],
      "notes": "Ruff is intentionally scoped to E9 and Pyflakes F rules first."
    },
    {
      "name": "git_diff_whitespace_check",
      "purpose": "Detect whitespace errors in the current changed diff before CI or review.",
      "path": ".github/workflows/governance-and-smoke.yml",
      "command": "git diff --check",
      "inputs": ["git diff state"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["git_read"],
      "permissions": ["git-read"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": ["git diff --check"]
    },
    {
      "name": "check_requirements_shape",
      "purpose": "Validate REQDOC, REQ, WS, traceability matrix, and external source-boundary metadata shape.",
      "path": "scripts/check_requirements_shape.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_requirements_shape.py",
      "inputs": ["docs/requirements"],
      "outputs": ["stdout report", "optional JSON report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 45,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "hook",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_requirements_shape.py"]
    },
    {
      "name": "check_context_budget",
      "purpose": "Warn when always-on context, active handoffs, ADR count, skills, or server declarations approach configured budgets.",
      "path": "scripts/check_context_budget.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_context_budget.py",
      "inputs": ["AGENTS.md", "docs/ai", ".agents/skills", ".codex/harness.toml"],
      "outputs": ["stdout warning report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 45,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "assistive",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_context_budget.py"]
    },
    {
      "name": "check_branch_hygiene",
      "purpose": "Audit GitHub branch hygiene, open PR budgets, stale branches, and failed open PRs.",
      "path": "scripts/check_branch_hygiene.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_branch_hygiene.py --strict",
      "inputs": ["git remote state", "GitHub API state", ".codex/harness.toml"],
      "outputs": ["stdout report", "optional JSON or markdown report", "process exit code"],
      "side_effects": ["git_read", "github_read", "network_read"],
      "permissions": ["git-read", "github-read", "network-read"],
      "timeout_seconds": 180,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "manual",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_branch_hygiene.py --strict"],
      "dangerous_flags": ["--delete-remote-stale", "--delete-local-stale", "--close-failed-dependabot-prs"],
      "notes": "Default strict audit is read-only; dangerous flags need separate human confirmation."
    },
    {
      "name": "check_github_guardrails",
      "purpose": "Audit local and remote GitHub guardrails including workflows, CODEOWNERS, PR template, permissions, Dependabot, and branch protection visibility.",
      "path": "scripts/check_github_guardrails.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_github_guardrails.py",
      "inputs": [".github", "git remote state", "GitHub API state"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["read_repo", "git_read", "github_read", "network_read"],
      "permissions": ["read-repo", "git-read", "github-read", "network-read"],
      "timeout_seconds": 180,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "manual",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_github_guardrails.py"],
      "notes": "Remote UNKNOWN and plan-limited findings are evidence, not success."
    },
    {
      "name": "reduce_runtime_observations",
      "purpose": "Reduce local runtime observation JSONL into a handoff-first markdown draft for main-agent review.",
      "path": "scripts/reduce_runtime_observations.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/reduce_runtime_observations.py",
      "inputs": [".codex/runtime/observations/*.jsonl", "CLI metadata flags"],
      "outputs": ["markdown draft on stdout or output file"],
      "side_effects": ["read_runtime", "write_runtime"],
      "permissions": ["read-runtime", "write-runtime"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "assistive",
      "verification_commands": ["python3 tests/test_runtime_reducer_metadata.py"]
    },
    {
      "name": "stop_runtime_observation",
      "purpose": "Append sanitized Stop hook observations and local agent-trace/v1 events for runtime recovery.",
      "path": ".codex/hooks/stop_runtime_observation.py",
      "command": ".codex/hooks/run_with_repo_python.sh .codex/hooks/stop_runtime_observation.py",
      "inputs": ["Codex Stop hook JSON payload on stdin", "git status", "runtime traceability catalog"],
      "outputs": [
        ".codex/runtime/observations/YYYY-MM-DD.jsonl",
        ".codex/runtime/observations/agent-traces/YYYY-MM-DD.agent-trace.jsonl",
        "process exit code"
      ],
      "side_effects": ["read_repo", "git_read", "write_runtime"],
      "permissions": ["read-repo", "git-read", "write-runtime"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "hook",
      "verification_commands": [
        "python3 tests/test_runtime_stop_hooks.py",
        ".codex/hooks/run_with_repo_python.sh scripts/check_agent_trace_schema.py"
      ],
      "notes": "Writes local runtime evidence only; it does not export to OpenTelemetry, OpenAI, or any remote trace backend."
    },
    {
      "name": "threejs_snake_smoke",
      "purpose": "Run deterministic browser smoke coverage for the Three.js snake slice through its smoke-only test API.",
      "path": "scripts/threejs_snake_smoke.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/threejs_snake_smoke.py",
      "inputs": ["apps/threejs-snake", "Playwright CLI package", "local browser runtime"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["read_repo", "launch_local_server", "browser_automation", "network_read"],
      "permissions": ["read-repo", "launch-local-server", "browser-automation", "network-read"],
      "timeout_seconds": 240,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/threejs_snake_smoke.py"]
    },
    {
      "name": "check_agent_trace_schema",
      "purpose": "Validate the repo-local agent trace JSON Schema and JSONL sample.",
      "path": "scripts/check_agent_trace_schema.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_agent_trace_schema.py",
      "inputs": ["docs/ai/standards/agent-trace.schema.json", "docs/ai/standards/agent-trace-sample.jsonl"],
      "outputs": ["stdout report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_agent_trace_schema.py"]
    },
    {
      "name": "check_agent_eval_dataset",
      "purpose": "Validate the standard agent workflow eval dataset shape and referenced repo checks.",
      "path": "scripts/check_agent_eval_dataset.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_agent_eval_dataset.py",
      "inputs": ["docs/ai/evals/agent-harness-evals.jsonl", "repository check scripts"],
      "outputs": ["stdout report", "optional JSON report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_agent_eval_dataset.py"]
    },
    {
      "name": "run_agent_eval_dataset",
      "purpose": "Run or dry-run the standard agent workflow eval dataset with a deterministic local grader.",
      "path": "scripts/run_agent_eval_dataset.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/run_agent_eval_dataset.py --dry-run",
      "inputs": ["docs/ai/evals/agent-harness-evals.jsonl", "repository check scripts"],
      "outputs": ["stdout report", "optional JSON report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 300,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [
        ".codex/hooks/run_with_repo_python.sh scripts/run_agent_eval_dataset.py --dry-run",
        "python3 tests/test_agent_eval_runner.py"
      ],
      "notes": "The default contract command is dry-run. Running without --dry-run executes each selected eval item's expected repo-local checks and should be an explicit local action."
    },
    {
      "name": "export_agent_trace_local",
      "purpose": "Convert agent-trace/v1 JSONL into a local JSON adapter payload without remote network export.",
      "path": "scripts/export_agent_trace.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/export_agent_trace.py --input docs/ai/standards/agent-trace-sample.jsonl",
      "inputs": ["agent-trace/v1 JSONL", "docs/ai/standards/agent-trace.schema.json"],
      "outputs": ["stdout JSON report", "optional local JSON output file", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [
        ".codex/hooks/run_with_repo_python.sh scripts/export_agent_trace.py --input docs/ai/standards/agent-trace-sample.jsonl",
        "python3 tests/test_agent_trace_export.py"
      ],
      "notes": "This adapter sets network_exported=false and does not claim OpenAI, OTLP, MCP, or A2A interoperability."
    },
    {
      "name": "export_agent_trace_otlp_pilot",
      "purpose": "Render agent-trace/v1 JSONL as OTLP HTTP JSON for local interop pilots; network export requires explicit --send and --endpoint.",
      "path": "scripts/export_agent_trace.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/export_agent_trace.py --input docs/ai/standards/agent-trace-sample.jsonl --format otlp-http-json",
      "inputs": ["agent-trace/v1 JSONL", "docs/ai/standards/agent-trace.schema.json", "explicit endpoint only when --send is used"],
      "outputs": ["stdout JSON report", "optional local JSON output file", "network_exported evidence flag", "optional HTTP status when --send is explicit"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [
        ".codex/hooks/run_with_repo_python.sh scripts/export_agent_trace.py --input docs/ai/standards/agent-trace-sample.jsonl --format otlp-http-json",
        "python3 tests/test_agent_trace_export.py"
      ],
      "dangerous_flags": ["--send", "--endpoint"],
      "notes": "Default command is no-network. Using --send performs an OTLP HTTP POST and must be treated as explicit manual interop evidence, not OpenAI/MCP/A2A completion."
    },
    {
      "name": "collect_harness_sample_gaps",
      "purpose": "List pending real-scenario sample gaps for security evidence, AI guardrails, workflow skills, and future trace interop.",
      "path": "scripts/collect_harness_sample_gaps.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/collect_harness_sample_gaps.py",
      "inputs": ["static sample gap registry in script"],
      "outputs": ["stdout markdown report", "optional JSON report", "process exit code"],
      "side_effects": ["none"],
      "permissions": ["none"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [
        ".codex/hooks/run_with_repo_python.sh scripts/collect_harness_sample_gaps.py",
        "python3 tests/test_harness_sample_gaps.py"
      ],
      "notes": "The collector targets missing real samples; it does not create evidence by itself."
    },
    {
      "name": "check_tool_contracts",
      "purpose": "Validate the standard tool contract registry without executing registered tools.",
      "path": "scripts/check_tool_contracts.py",
      "command": ".codex/hooks/run_with_repo_python.sh scripts/check_tool_contracts.py",
      "inputs": ["docs/ai/tool-contracts/contracts.json", "repository tool paths"],
      "outputs": ["stdout report", "optional JSON report", "process exit code"],
      "side_effects": ["read_repo"],
      "permissions": ["read-repo"],
      "timeout_seconds": 30,
      "destructive": false,
      "externally_visible": false,
      "automation_mode": "ci",
      "verification_commands": [".codex/hooks/run_with_repo_python.sh scripts/check_tool_contracts.py"]
    }
  ]
}
