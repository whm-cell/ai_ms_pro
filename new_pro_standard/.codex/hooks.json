{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py pre_tool_use_preflight.py",
            "statusMessage": "Checking tool preflight risks",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py session_start_runtime_context.py",
            "statusMessage": "Loading runtime session context",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py stop_runtime_observation.py",
            "statusMessage": "Capturing runtime observations",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py stop_runtime_session.py",
            "statusMessage": "Persisting runtime session snapshot",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py stop_runtime_token_pressure.py",
            "statusMessage": "Checking runtime token pressure",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py stop_loop_scope_monitor.py",
            "statusMessage": "Checking loop and scope drift",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".codex/hooks/run_hook.py stop_ai_docs_check.py",
            "statusMessage": "Checking AI docs governance",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
